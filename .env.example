# ============================================
# 통합 블로그 시스템 환경 변수 설정
# 이 파일을 .env로 복사한 후 값을 수정하세요.
# cp .env.example .env
# ============================================

# --- PostgreSQL 설정 ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
POSTGRES_PORT=5432

# --- JWT 인증 설정 ---
# 프로덕션 환경에서는 반드시 안전한 시크릿 키로 변경하세요
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO 스토리지 설정 ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=blog-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- 백엔드 설정 ---
BACKEND_PORT=8000
DEBUG=false

# --- 프론트엔드 설정 ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://backend:8000
